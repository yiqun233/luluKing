{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "最小权限：本地数据库、设置、受限应用数据目录及 HTTPS AI 请求",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/luluKing" },
        { "path": "$APPDATA/luluKing/**" },
        { "path": "$APPDATA/files" },
        { "path": "$APPDATA/files/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/luluKing" },
        { "path": "$APPDATA/luluKing/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/luluKing/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/luluKing/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/luluKing/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/luluKing/files/**" },
        { "path": "$APPDATA/files/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/luluKing/files/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPDATA/luluKing/files/**" },
        { "path": "$APPDATA/files/**" }
      ]
    },
    "fs:deny-default"
  ]
}
